groups:
- name: linuxHostStatusAlert
  rules:
  - alert: linuxNodeDown
    expr: up{job=~".*node_exporter.*"} == 0
    for: 30s
    labels:
      severity: High
    annotations:
      summary: "node_exporter is Down"
      description: "app: {{ $labels.app }}, linux node is Down(current value: {{ $value }})"

  - alert: linuxHostCpuUsageAlert
    expr: (sum((avg(irate(node_cpu_seconds_total{job=~".*node_exporter.*",mode!="idle"}[5m]))  without(cpu)))  by(instance,team,project,job,app) ) * 100 >85
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Host CPU[5m] usage High"
      description: "app: {{ $labels.app }}, linux node CPU Usage above 85%/5m (current value: {{ $value }})"

  - alert: linuxHostCpuUsage100%Alert
    expr: (sum((avg(irate(node_cpu_seconds_total{job=~".*node_exporter.*",mode!="idle"}[5m]))  without(cpu)))  by(instance,team,project,job,app) ) * 100 >=99
    for: 1m
    labels:
      severity: High
    annotations:
      summary: "Host CPU[5m] usage High"
      description: "app: {{ $labels.app }}, linux node CPU Usage above equal 99%/5m (current value: {{ $value }})"

  - alert: linuxHostMemUsageAlert
    expr: (((node_memory_MemTotal_bytes{job=~".*node_exporter.*"} - node_memory_MemAvailable_bytes{job=~".*node_exporter.*"}) / node_memory_MemTotal_bytes{job=~".*node_exporter.*"} * 100) or (1 - ((node_memory_Buffers_bytes{job=~".*node_exporter.*"} + node_memory_Cached_bytes{job=~".*node_exporter.*"} + node_memory_MemFree_bytes{job=~".*node_exporter.*"}) / node_memory_MemTotal_bytes{job=~".*node_exporter.*"})) * 100) > 90
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Memory usage High"
      description: "app: {{ $labels.app }}, linux node Memory Usage above 90% (current value: {{ $value }})"

  - alert: linuxHostMemUsage100%Alert
    expr: (((node_memory_MemTotal_bytes{job=~".*node_exporter.*"} - node_memory_MemAvailable_bytes{job=~".*node_exporter.*"}) / node_memory_MemTotal_bytes{job=~".*node_exporter.*"} * 100)  or (1 - ((node_memory_Buffers_bytes{job=~".*node_exporter.*"} + node_memory_Cached_bytes{job=~".*node_exporter.*"} + node_memory_MemFree_bytes{job=~".*node_exporter.*"} ) /node_memory_MemTotal_byte{job=~".*node_exporter.*"} )) * 100)  >= 99
    for: 1m 
    labels:
      severity: High
    annotations:
      summary: "Host Memory usage High"
      description: "app: {{ $labels.app }}, linux node Memory Usage above equal 99% (current value: {{ $value }})"

  - alert: linuxHostDiskUsageCapacityAlert
    expr: (100-(node_filesystem_free_bytes{fstype=~"ext4|xfs",job=~".*node_exporter.*"}/node_filesystem_size_bytes {fstype=~"ext4|xfs",job=~".*node_exporter.*"}*100)) > 90
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk Usage Capacity High"
      description: "app: {{ $labels.app }}, linux node Host Disk Capacity Usage above 90% (path: {{ $labels.mountpoint }},value: {{ $value }})"

  - alert: linuxHostDiskAvailableCapacityAlert
    expr: node_filesystem_free_bytes{fstype=~"ext4|xfs",mountpoint!="/boot",job=~".*node_exporter.*"} / 1024 /1024 /1024 < 1
    for: 1m 
    labels:
      severity: High
    annotations:
      summary: "Host Disk Available Capacity Low"
      description: "app: {{ $labels.app }}, linux node Host Disk Available Capacity under 1G (path: {{ $labels.mountpoint }},value: {{ $value }})"

  - alert: linuxHostDiskReadRateAlert
    expr: irate(node_disk_read_bytes_total{job=~".*node_exporter.*",vip!="192.168.xxx"}[5m]) /1024 /1024 > 60
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk Read Rate High"
      description: "app: {{ $labels.app }}, linux node Disk Read Rate above 60M/5m (device: {{ $labels.device }},value: {{ $value }})"

  - alert: linuxHostDiskReadRateForMysqlAlert
    expr: irate(node_disk_read_bytes_total{job=~".*node_exporter.*",vip="192.168.xxx"}[5m]) /1024 /1024 > 120
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk Read Rate High"
      description: "app: {{ $labels.app }}, linux node Disk Read Rate above 120M/5m (device: {{ $labels.device }},value: {{ $value }})"


  - alert: linuxHostDiskWriteRateAlert
    expr: irate(node_disk_written_bytes_total{job=~".*node_exporter.*"}[5m]) /1024 /1024 > 60
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk[5m] Write Rate High"
      description: "app: {{ $labels.app }}, linux node Disk Write Rate above 60M/5m (device: {{ $labels.device }},value: {{ $value }})"

  - alert: linuxHostDiskIOPSReadRateAlert
    expr: topk(1,irate(node_disk_reads_completed_total{job=~".*node_exporter.*",instance!~"192.168.xxx:9100"}[5m])) > 2000
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk[5m] IOPS Read Rate High"
      description: "app: {{ $labels.app }}, linux node Disk Read IOPS Rate above 1500/5m (device: {{ $labels.device }},value: {{ $value }})"

  - alert: linuxHostDiskIOPSWriteRateAlert
    expr: topk(1,irate(node_disk_writes_completed_total{job=~".*node_exporter.*",instance!~"192.168.xxx:9100"}[5m])) > 2000
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Disk[5m] IOPS Write Rate High"
      description: "app: {{ $labels.app }}, linux node Disk Write IOPS Rate above 1500/5m (device: {{ $labels.device }},value: {{ $value }})"

  - alert: linuxHostNetworkReceiveAlert
    expr: irate(node_network_receive_bytes_total{device!~"tap.*|veth.*|br.*|docker.*|virbr*|lo*",job=~".*node_exporter.*"}[5m]) * 8 / 1024 / 1024 > 200
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Network[5m] Receive Rate High"
      description: "app: {{ $labels.app }}, linux node Network Download rate above 200Mbps/5m (current value: {{ $value }})"

  - alert: linuxHostNetworkSendAlert
    expr: irate(node_network_transmit_bytes_total{device!~"tap.*|veth.*|br.*|docker.*|virbr*|lo*",job=~".*node_exporter.*"}[5m]) * 8 / 1024 / 1024 > 200
    for: 5m 
    labels:
      severity: critical
    annotations:
      summary: "Host Network[5m] Send Rate High"
      description: "app: {{ $labels.app }}, linux node Network Send rate above 200Mbps/5m (current value: {{ $value }})"

  - alert: linuxHostNetworkEstablishedConnectionAlert
    expr: node_netstat_Tcp_CurrEstab  > 5000
    for: 1m 
    labels:
      severity: critical
    annotations:
      summary: "Host Network[5m] Established Connection High"
      description: "app: {{ $labels.app }}, linux node Network Established Connection above 5000 (current value: {{ $value }})"
