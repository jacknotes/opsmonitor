groups:
- name: redisStatusAlert
  rules:
  - alert: RedisDown
    expr: redis_up{job=~".*redis_exporter.*"} == 0
    for: 30s
    labels:
      severity: High
    annotations:
      summary: "Redis is Down"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis instance is Down (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisMasterLinkDownAlert
    expr: redis_master_link_up{job=~".*redis_exporter.*"} < 1
    for: 30s
    labels:
      severity: High
    annotations:
      summary: "Redis Slave Lost Master Link"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis slave connection to master is down, replication broken (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisMemoryUsageAlert
    expr: (redis_memory_used_bytes{job=~".*redis_exporter.*"} / redis_memory_max_bytes{job=~".*redis_exporter.*"}) * 100 > 90 and on(instance) (redis_memory_max_bytes{job=~".*redis_exporter.*"} > 0)
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Redis Memory usage High"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis memory usage above 90% of maxmemory (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisClientConnectNumberAlert
    expr: redis_connected_clients{job=~".*redis_exporter.*"} > 4000
    for: 1m
    labels:
      severity: critical
    annotations:
      summary: "Redis Client Connect Number High"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis connected clients above 4000 (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisRejectedConnectionsAlert
    expr: increase(redis_rejected_connections_total{job=~".*redis_exporter.*"}[5m]) > 0
    for: 1m
    labels:
      severity: High
    annotations:
      summary: "Redis Rejected Connections"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis rejected connections in last 5m, maxclients or TCP backlog reached (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisBgSaveFailedAlert
    expr: redis_rdb_last_bgsave_status{job=~".*redis_exporter.*"} == 0
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Redis RDB BgSave Failed"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis last RDB bgsave failed, persistence broken (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisAofRewriteFailedAlert
    expr: redis_aof_last_bgrewrite_status{job=~".*redis_exporter.*"} == 0 and on(instance) (redis_aof_enabled{job=~".*redis_exporter.*"} == 1)
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "Redis AOF Rewrite Failed"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis last AOF rewrite failed, persistence broken (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisEvictedKeysAlert
    expr: increase(redis_evicted_keys_total{job=~".*redis_exporter.*"}[5m]) > 0
    for: 1m
    labels:
      severity: High
    annotations:
      summary: "Redis Keys Evicted"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis evicted keys in last 5m, memory pressure (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisFragmentationRatioAlert
    expr: redis_mem_fragmentation_ratio{job=~".*redis_exporter.*", app!~"fat.*|uat.*"} > 1.5 and on(instance) (redis_memory_used_bytes{job=~".*redis_exporter.*"} > 1073741824)
    for: 15m
    labels:
      severity: High
    annotations:
      summary: "Redis Memory Fragmentation High"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, Redis mem_fragmentation_ratio above 1.5 with used_memory over 1G (instance: {{ $labels.instance }}, current value: {{ $value }})"

  - alert: RedisSlowlogGrowthAlert
    expr: increase(redis_slowlog_length{job=~".*redis_exporter.*"}[15m]) > 0
    for: 5m
    labels:
      severity: High
    annotations:
      summary: "Redis Slowlog Growing"
      description: "app: {{ $labels.app }}, env: {{ $labels.env }}, new slow queries recorded in last 15m, check SLOWLOG GET (instance: {{ $labels.instance }}, current value: {{ $value }})"
