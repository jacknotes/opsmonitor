{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "当前在线的 kube-apiserver 实例数（up==1 计数，or vector(0) 兜底）；0 或低于预期副本数说明 apiserver 掉线，集群将无法进行任何管理操作",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(up{kubernetes_cluster=~\"$kubernetes_cluster\",job=~\".*apiserver.*\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "API Server 在线",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "kube-apiserver 每秒接收的请求总量（apiserver_request_total 2m 速率），反映控制面整体请求压力",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(apiserver_request_total{kubernetes_cluster=~\"$kubernetes_cluster\"}[2m]))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "请求 QPS",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "apiserver 返回 5xx 服务端错误的请求占比（2m 速率）；超过 1% 黄色、5% 红色，5xx 持续出现需结合 apiserver/etcd 日志排查",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(apiserver_request_total{kubernetes_cluster=~\"$kubernetes_cluster\",code=~\"5..\"}[2m])) / sum(rate(apiserver_request_total{kubernetes_cluster=~\"$kubernetes_cluster\"}[2m]))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "5xx 错误率",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "读写请求（排除 WATCH/CONNECT 长连接）的 P99 处理延迟（毫秒）；超过 500ms 黄色、2s 红色，通常由 etcd 压力或 admission webhook 变慢引起",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(apiserver_request_duration_seconds_bucket{kubernetes_cluster=~\"$kubernetes_cluster\",verb!~\"CONNECT|WATCH\"}[2m])) by (le)) * 1000",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "请求 P99 延迟",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "当前正在处理中的请求数（apiserver_current_inflight_requests）；接近 max_inflight（只读 400/变更 800）时 apiserver 开始返回 429 限流",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 400 },
              { "color": "red", "value": 800 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(apiserver_current_inflight_requests{kubernetes_cluster=~\"$kubernetes_cluster\"})",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Inflight 处理中请求",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "客户端证书剩余有效期的 5% 分位（按认证请求观测，即最短的一批证书）；低于 30 天黄色、7 天红色，提示尽快轮换 kubeconfig/组件证书",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.05, sum(rate(apiserver_client_certificate_expiration_seconds_bucket{kubernetes_cluster=~\"$kubernetes_cluster\"}[5m])) by (le)) / 86400",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "证书剩余有效期（天）",
      "type": "stat"
    },
