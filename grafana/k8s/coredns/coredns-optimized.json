    {
      "datasource": "Prometheus",
      "description": "CoreDNS 进程 panic 次数（所选时间范围内增量，or vector(0) 兜底）；正常恒为 0，出现任何值都需要结合 CoreDNS 版本排查插件 bug",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
