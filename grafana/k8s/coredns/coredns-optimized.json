  "panels": [
    {
      "datasource": "Prometheus",
      "description": "每秒 DNS 查询请求总量（coredns_dns_requests_total 2m 速率），反映集群整体 DNS 查询压力",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(coredns_dns_requests_total{kubernetes_cluster=~\"$kubernetes_cluster\",k8s_app=~\"$service\"}[2m]))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "DNS 请求 QPS",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "CoreDNS 缓存命中率（hits/(hits+misses) 2m 速率占比）；低于 50% 红色、低于 80% 黄色，持续偏低说明缓存容量偏小或查询模式高度随机",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(coredns_cache_hits_total{kubernetes_cluster=~\"$kubernetes_cluster\",k8s_app=~\"$service\"}[2m])) / (sum(rate(coredns_cache_hits_total{kubernetes_cluster=~\"$kubernetes_cluster\",k8s_app=~\"$service\"}[2m])) + sum(rate(coredns_cache_misses_total{kubernetes_cluster=~\"$kubernetes_cluster\",k8s_app=~\"$service\"}[2m])))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "缓存命中率",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "全部 DNS 请求的 P99 处理延迟（histogram_quantile 0.99，毫秒）；超过 100ms 标红，通常意味着上游转发链路抖动或 CoreDNS 负载过高",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(coredns_dns_request_duration_seconds_bucket{kubernetes_cluster=~\"$kubernetes_cluster\",k8s_app=~\"$service\"}[2m])) by (le)) * 1000",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "请求 P99 延迟",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "CoreDNS 回复响应的速率（coredns_dns_responses_total 2m 速率）；与请求 QPS 长期不匹配说明存在查询超时丢失",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
