          "datasource": "Prometheus",
          "expr": "max by (exported_namespace, pod) (min_over_time(kube_pod_status_ready{kubernetes_cluster=~\"$kubernetes_cluster\",exported_namespace=~\"$namespace\",condition=\"false\"}[5m]) == 1 and on (exported_namespace, pod) (time() - kube_pod_start_time{kubernetes_cluster=~\"$kubernetes_cluster\",exported_namespace=~\"$namespace\"} >= 300) and on (exported_namespace, pod) kube_pod_status_phase{kubernetes_cluster=~\"$kubernetes_cluster\",exported_namespace=~\"$namespace\",phase=\"Running\"} == 1)",
